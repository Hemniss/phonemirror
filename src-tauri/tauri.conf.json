{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneMirror",
  "version": "0.1.0",
  "identifier": "com.hemniss.phonemirror",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PhoneMirror",
        "width": 980,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/scrcpy/": "scrcpy/"
    },
    "shortDescription": "Streamez votre téléphone Android sur votre PC",
    "longDescription": "PhoneMirror affiche et contrôle l'écran de votre téléphone Android depuis votre ordinateur, en USB ou en WiFi. scrcpy et adb sont inclus : aucune installation supplémentaire n'est nécessaire.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0"]
      }
    }
  }
}
